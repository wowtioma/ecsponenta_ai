ryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_right" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="325.0"/><mxPoint x="900" y="392.0"/></Array></mxGeometry></mxCell><mxCell id="p14" value="3 · NTP, UDP 123" style="rounded=1;arcSize=50;fillColor=#354552;strokeColor=none;html=1;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Open Sans;" vertex="1" parent="1"><mxGeometry x="1011" y="383.0" width="117" height="18" as="geometry"/></mxCell><mxCell id="c15" value="Правил Синоникса: 3" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=13;fontStyle=1;fontFamily=Open Sans;" vertex="1" parent="1"><mxGeometry x="40" y="476" width="1370" height="30" as="geometry"/></mxCell><mxCell id="m16" value="" style="rounded=1;arcSize=30;fillColor=#E06733;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="519" width="12" height="12" as="geometry"/></mxCell><mxCell id="l17" value="1. Программа диспетчера из общей сети водоканала опрашивает контроллер насосов и получает давление и уровень воды: Modbus TCP, порт 502, двунаправленное правило." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=11;fontFamily=Open Sans;" vertex="1" parent="1"><mxGeometry x="62" y="510" width="1350" height="30" as="geometry"/></mxCell><mxCell id="m18" value="" style="rounded=1;arcSize=30;fillColor=#35C4AF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="12" height="12" as="geometry"/></mxCell><mxCell id="l19" value="2. Компьютер оператора насосной станции отправляет журналы событий на сервер мониторинга в общей сети водоканала: UDP 514, однонаправленное правило." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=11;fontFamily=Open Sans;" vertex="1" parent="1"><mxGeometry x="62" y="536" width="1350" height="30" as="geometry"/></mxCell><mxCell id="m20" value="" style="rounded=1;arcSize=30;fillColor=#FFAB4D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="571" width="12" height="12" as="geometry"/></mxCell><mxCell id="l21" value="3. Сервер времени из общей сети водоканала передаёт точное время на сервер времени станции: NTP, UDP 123, однонаправленное правило." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=11;fontFamily=Open Sans;" vertex="1" parent="1"><mxGeometry x="62" y="562" width="1350" height="30" as="geometry"/></mxCell><mxCell id="l22" value="МЭ стоит на границе закрытого сегмента. Синоникс размещён в закрытом сегменте сразу за МЭ: Узел А обращён к открытой сети, Узел В к системам закрытого сегмента." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#B9C5CD;fontSize=11;fontFamily=Open Sans;" vertex="1" parent="1"><mxGeometry x="62" y="588" width="1350" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>