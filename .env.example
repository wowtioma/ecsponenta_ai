# Участник B: настройка провайдера LLM. Скопируй в файл .env и заполни.

# Веб-приложение использует Groq. ТЗ §7 ограничивает входной тариф
# каждой модели выбранного варианта OpenRouter суммой $0.10/1M.
LLM_PROVIDER=groq

# --- Вариант 1: OpenRouter (нужна оплата: USDC/зарубежная карта) ---
OPENROUTER_API_KEY=
# Вход <= $0.10/1M. Проверь на openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# --- Вариант 2: Yandex AI Studio (оплата РФ картой, но дороже лимита) ---
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_MODEL=gpt-oss-20b

# --- Вариант 3: GigaChat (оплата РФ картой) ---
# GIGACHAT_API_KEY=
# GIGACHAT_MODEL=GigaChat-Pro

# По умолчанию используются Markdown-файлы из каталога репозитория.
# SYNONYX_BASE_DIR=synonyx_base

# --- Groq ---
# LLM_PROVIDER=groq
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=
# Для нескольких локальных ключей создай .env.groq и выбери слот перед запуском.
# Стартовый слот. При HTTP 429 клиент попробует следующие заполненные слоты.
# GROQ_ACTIVE_SLOT=1
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# Ответы по рассчитанному проекту через модель. Вопросы формирует ядро.
# SYNONYX_LLM_WORDING=1
