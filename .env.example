# Участник B: настройка провайдера LLM. Скопируй в файл .env и заполни.

# Профиль: openrouter (по умолчанию) | yandex | gigachat | groq
# ВНИМАНИЕ (ТЗ §7): зачётный прогон требует модель из каталога OpenRouter
# с входным тарифом <= $0.10/1M. Профили yandex/gigachat — только для разработки
# или если организаторы ПИСЬМЕННО разрешили «другой API для той же модели».
LLM_PROVIDER=openrouter

# --- Вариант 1: OpenRouter (нужна оплата: USDC/зарубежная карта) ---
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXX
# Вход <= $0.10/1M. Проверь на openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# --- Вариант 2: Yandex AI Studio (оплата РФ картой, но дороже лимита) ---
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_MODEL=gpt-oss-20b

# --- Вариант 3: GigaChat (оплата РФ картой) ---
# GIGACHAT_API_KEY=
# GIGACHAT_MODEL=GigaChat-Pro

# Путь к базе знаний (не менять, если папка кейса лежит в корне проекта)
# SYNONYX_BASE_DIR=Кейс АйТи Бастион — Синоникс/synonyx_base

# --- Groq ---
# LLM_PROVIDER=groq
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=
# Для нескольких локальных ключей создай .env.groq и выбери слот перед запуском.
# GROQ_ACTIVE_SLOT=1
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
